generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  LECTURER
  STUDENT
}

enum ExamStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  GRADED
  REVIEWED
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  FILL_BLANK
  SUBJECTIVE
}

model Department {
  id          BigInt   @id @default(autoincrement())
  name        String   @unique
  code        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  courses Course[]
  users   User[]

  @@map("departments")
}

model Course {
  id           BigInt   @id @default(autoincrement())
  departmentId BigInt   @map("department_id")
  title        String
  code         String   @unique
  description  String?
  credits      Int      @default(3)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  department        Department        @relation(fields: [departmentId], references: [id])
  enrollments       CourseEnrollment[]
  questionBanks     QuestionBank[]
  exams             Exam[]
}

model User {
  id           BigInt    @id @default(autoincrement())
  email        String    @unique
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  role         Role
  departmentId BigInt?   @map("department_id")
  isActive     Boolean   @default(true) @map("is_active")
  passwordHash String?   @map("password_hash")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  department        Department?       @relation(fields: [departmentId], references: [id])
  enrollments       CourseEnrollment[]
  createdBanks      QuestionBank[]    @relation("CreatedBanks")
  createdExams      Exam[]            @relation("CreatedExams")
  examAttempts      ExamAttempt[]
  gradedAnswers     StudentAnswer[]   @relation("GradedAnswers")
  releasedResults   Result[]          @relation("ReleasedResults")
  auditLogs         AuditLog[]
  loginHistory      LoginHistory[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model CourseEnrollment {
  id        BigInt   @id @default(autoincrement())
  studentId BigInt   @map("student_id")
  courseId  BigInt   @map("course_id")
  enrolledAt DateTime @default(now()) @map("enrolled_at")

  student User   @relation(fields: [studentId], references: [id])
  course  Course @relation(fields: [courseId], references: [id])

  @@unique([studentId, courseId])
  @@map("course_enrollments")
}

model QuestionBank {
  id          BigInt    @id @default(autoincrement())
  title       String
  description String?
  courseId     BigInt    @map("course_id")
  createdById  BigInt    @map("created_by")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  course    Course     @relation(fields: [courseId], references: [id])
  createdBy User       @relation("CreatedBanks", fields: [createdById], references: [id])
  questions Question[]
  exams     Exam[]

  @@map("question_banks")
}

model Question {
  id             BigInt       @id @default(autoincrement())
  questionBankId BigInt       @map("question_bank_id")
  content        String
  questionType   QuestionType @map("question_type")
  points         Int          @default(1)
  choices        Json?
  correctAnswer  String?      @map("correct_answer")
  explanation    String?
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at")

  questionBank  QuestionBank   @relation(fields: [questionBankId], references: [id])
  examQuestions ExamQuestion[]
  studentAnswers StudentAnswer[]

  @@map("questions")
}

model Exam {
  id                    BigInt      @id @default(autoincrement())
  title                 String
  description           String?
  courseId              BigInt      @map("course_id")
  questionBankId        BigInt      @map("question_bank_id")
  createdById           BigInt      @map("created_by")
  durationMinutes       Int         @map("duration_minutes")
  passingScore          Int         @default(50) @map("passing_score")
  maxAttempts           Int?        @default(1) @map("max_attempts")
  maxTabSwitches        Int?        @map("max_tab_switches")
  shuffleQuestions      Boolean?    @default(true) @map("shuffle_questions")
  shuffleChoices        Boolean?    @default(true) @map("shuffle_choices")
  showResultsImmediately Boolean?   @default(false) @map("show_results_immediately")
  startTime             DateTime    @map("start_time")
  endTime               DateTime    @map("end_time")
  status                ExamStatus  @default(DRAFT)
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @default(now()) @updatedAt @map("updated_at")

  course       Course         @relation(fields: [courseId], references: [id])
  questionBank QuestionBank   @relation(fields: [questionBankId], references: [id])
  createdBy    User           @relation("CreatedExams", fields: [createdById], references: [id])
  examQuestions ExamQuestion[]
  examAttempts  ExamAttempt[]

  @@index([courseId])
  @@index([status])
  @@index([startTime, endTime])
  @@map("exams")
}

model ExamQuestion {
  id             BigInt @id @default(autoincrement())
  examId         BigInt @map("exam_id")
  questionId     BigInt @map("question_id")
  questionOrder  Int    @map("question_order")
  pointsOverride Int?   @map("points_override")

  exam     Exam     @relation(fields: [examId], references: [id])
  question Question @relation(fields: [questionId], references: [id])

  @@unique([examId, questionId])
  @@map("exam_questions")
}

model ExamAttempt {
  id             BigInt        @id @default(autoincrement())
  examId         BigInt        @map("exam_id")
  studentId      BigInt        @map("student_id")
  attemptNumber  Int           @default(1) @map("attempt_number")
  status         AttemptStatus @default(IN_PROGRESS)
  questionOrder  Json?         @map("question_order")
  choiceOrder    Json?         @map("choice_order")
  startedAt      DateTime      @default(now()) @map("started_at")
  submittedAt    DateTime?     @map("submitted_at")
  tabSwitchCount Int           @default(0) @map("tab_switch_count")
  ipAddress      String?       @map("ip_address")
  userAgent      String?       @map("user_agent")

  exam          Exam            @relation(fields: [examId], references: [id])
  student       User            @relation(fields: [studentId], references: [id])
  studentAnswers StudentAnswer[]
  result        Result?

  @@unique([examId, studentId, attemptNumber])
  @@index([studentId])
  @@index([examId])
  @@map("exam_attempts")
}

model StudentAnswer {
  id              BigInt    @id @default(autoincrement())
  attemptId       BigInt    @map("attempt_id")
  questionId      BigInt    @map("question_id")
  answerText      String?   @map("answer_text")
  selectedChoices String?   @map("selected_choices")
  isCorrect       Boolean?  @map("is_correct")
  scoreObtained   Decimal?  @default(0) @map("score_obtained")
  gradedById      BigInt?   @map("graded_by")
  gradedAt        DateTime? @map("graded_at")

  attempt  ExamAttempt @relation(fields: [attemptId], references: [id])
  question Question    @relation(fields: [questionId], references: [id])
  gradedBy User?       @relation("GradedAnswers", fields: [gradedById], references: [id])

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@map("student_answers")
}

model Result {
  id         BigInt    @id @default(autoincrement())
  attemptId  BigInt    @unique @map("attempt_id")
  totalScore Decimal   @default(0) @map("total_score")
  maxScore   Decimal   @default(0) @map("max_score")
  percentage Decimal?  @map("percentage")
  passed     Boolean   @default(false)
  isReleased  Boolean   @default(false) @map("is_released")
  releasedById BigInt?   @map("released_by")
  releasedAt  DateTime? @map("released_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  attempt     ExamAttempt @relation(fields: [attemptId], references: [id])
  releasedBy  User?       @relation("ReleasedResults", fields: [releasedById], references: [id])

  @@map("results")
}

model AuditLog {
  id           BigInt   @id @default(autoincrement())
  userId       BigInt?  @map("user_id")
  action       String
  resourceType String?  @map("resource_type")
  resourceId   BigInt?  @map("resource_id")
  details      Json?
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  performedAt  DateTime @default(now()) @map("performed_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([performedAt])
  @@map("audit_logs")
}

model LoginHistory {
  id              BigInt   @id @default(autoincrement())
  userId          BigInt?  @map("user_id")
  ipAddress       String?  @map("ip_address")
  userAgent       String?  @map("user_agent")
  loginSuccessful Boolean? @default(false) @map("login_successful")
  failureReason   String?  @map("failure_reason")
  loggedAt        DateTime @default(now()) @map("logged_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([loggedAt])
  @@map("login_history")
}
